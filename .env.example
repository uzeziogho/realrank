# ─────────────────────────────────────────────────────────────
# RealRank environment variables
# Copy to .env.local and fill in. NEVER commit real secrets.
# ─────────────────────────────────────────────────────────────

# Public site URL (used for metadata, canonical tags, sitemap, OAuth redirect)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase ──
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Bypasses RLS — used by cron + admin tasks. Never expose to client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Google OAuth 2.0 (scope: webmasters.readonly) ──
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# Must match an authorized redirect URI in the Google Cloud console
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# ── Token encryption ──
# 32-byte key, base64 encoded. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=your-base64-32-byte-key

# ── Vercel Cron protection ──
# Secret checked by /api/cron/refresh to reject unauthorized calls.
CRON_SECRET=your-random-cron-secret
