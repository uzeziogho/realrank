# ─────────────────────────────────────────────────────────────
# RealRank environment variables
# Copy to .env.local and fill in. NEVER commit real secrets.
# ─────────────────────────────────────────────────────────────

# Public site URL (used for metadata, canonical tags, sitemap, OAuth redirect)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase ──
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Bypasses RLS — used by cron + admin tasks. Never expose to client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Google OAuth 2.0 (scope: webmasters.readonly) ──
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# Must match an authorized redirect URI in the Google Cloud console
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# ── Token encryption ──
# 32-byte key, base64 encoded. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=your-base64-32-byte-key

# ── Vercel Cron protection ──
# Secret checked by /api/cron/refresh to reject unauthorized calls.
CRON_SECRET=your-random-cron-secret

# ── Claude / Anthropic (optional AI enrichment) ──
# When set, new listings get their category and "alternative to" auto-filled
# (only the fields left blank, only when Claude is confident). Server-only.
# Unset = feature is a complete no-op; listings work exactly as before.
# ANTHROPIC_API_KEY=sk-ant-...
# Model defaults to claude-opus-5-5. For this classification, Haiku is far
# cheaper and plenty capable — uncomment to use it:
# ANTHROPIC_MODEL=claude-haiku-5-5

# ── RealRank Archive (validation) ──
# Payment link for the founding offer on /archive (e.g. a Dodo Payments checkout
# URL). Must start with https://. Unset → the buy buttons fall back to the
# waitlist, so /archive is safe to publish before checkout exists.
# ARCHIVE_FOUNDING_CHECKOUT_URL=https://checkout.dodopayments.com/buy/...

# ── Email (Resend) ──
# One Resend account + one VERIFIED DOMAIN (realrank.lol) powers all mail.
# Verify the domain, not a single address, so you can send from any @realrank.lol.
#
# Resend API key (https://resend.com → API Keys). Server-only. Shared by every
# send — transactional (submit confirmations) and the weekly digest.
# RESEND_API_KEY=re_...
# Default From for transactional mail (submit confirmations, receipts). MUST be
# on your Resend-verified domain. Display name is allowed. Falls back to
# DIGEST_FROM if unset. Without this (or DIGEST_FROM) no transactional mail sends.
# EMAIL_FROM=RealRank <hello@realrank.lol>
#
# ── Weekly Movers digest email (optional, OFF by default) ──
# The weekly cron always computes the digest and posts the webhook. Email is a
# separate step that stays silent until DIGEST_EMAIL_ENABLED is "true", a
# RESEND_API_KEY (above) is set, and DIGEST_FROM is a verified sender — mail is
# the one thing here that can't be unsent, so the default is silence.
# See lib/digest-email.ts.
# DIGEST_EMAIL_ENABLED=true
# The digest's own From, verified in Resend (can differ from EMAIL_FROM, e.g. a
# movers@ address). If unset, transactional mail still uses EMAIL_FROM:
# DIGEST_FROM=RealRank <movers@realrank.lol>
# Also mail the contact address people left with a listing. OFF by default:
# those addresses arrived as a contact for that listing, not as a newsletter
# sign-up, so turning this on is a consent decision — make sure the privacy
# policy says so first. The waitlist is mailed either way.
# DIGEST_INCLUDE_LISTINGS=true
#
# Unsubscribe links are HMAC-signed with CRON_SECRET (above), so that must be
# set too or no send happens.
